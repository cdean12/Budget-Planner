                                                                        {dayBills.slice(0, 2).map((bill, idx) => (
                                                                            <span key={idx} style={{ fontSize: '0.8rem', opacity: isBillPaid(bill.id, currentYear, currentMonth, bill.occurrenceDay) ? 0.4 : 1 }} title={bill.name + ': ' + formatCurrency(bill.amount)}>
