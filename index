                                                    {day}
                                                </div>
                                            ))}
                                        </div>
                                        
                                        {/* Calendar Grid */}
                                        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: '4px' }}>
                                            {calendarDays.map((day, index) => {
                                                if (day === null) {
                                                    return <div key={`empty-${index}`} style={{ aspectRatio: '1', background: 'transparent' }} />;
                                                }
                                                
                                                const isToday = day === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear();
                                                const dayBills = billsByDay[day] || [];
                                                
                                                const hasOverdue = dayBills.some(bill => {
                                                    const occDate = new Date(currentYear, currentMonth, bill.occurrenceDay);
                                                    const todayOnly = new Date(today.getFullYear(), today.getMonth(), today.getDate());
                                                    return occDate < todayOnly && !isBillPaid(bill.id, currentYear, currentMonth, bill.occurrenceDay);
