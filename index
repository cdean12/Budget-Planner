                                    if (currentMonth === 0) {
                                        setCalendarMonth(11);
                                        setCalendarYear(currentYear - 1);
                                    } else {
                                        setCalendarMonth(currentMonth - 1);
                                    }
                                };
                                
                                const goToNextMonth = () => {
                                    if (currentMonth === 11) {
                                        setCalendarMonth(0);
                                        setCalendarYear(currentYear + 1);
                                    } else {
                                        setCalendarMonth(currentMonth + 1);
                                    }
                                };
                                
                                const goToToday = () => {
                                    setCalendarMonth(today.getMonth());
                                    setCalendarYear(today.getFullYear());
                                };
                                
                                // Calendar calculations
                                const firstDay = new Date(currentYear, currentMonth, 1);
                                const lastDay = new Date(currentYear, currentMonth + 1, 0);
                                const daysInMonth = lastDay.getDate();
                                const startingDayOfWeek = firstDay.getDay();
                                
                                const calendarDays = [];
                                for (let i = 0; i < startingDayOfWeek; i++) {
                                    calendarDays.push(null);
                                }
                                for (let day = 1; day <= daysInMonth; day++) {
                                    calendarDays.push(day);
                                }
                                
                                // Get bills for current month - supports recurring
                                const getBillOccurrences = (bill, year, month) => {
                                    const start = new Date(bill.dueDate);
                                    // Normalize to avoid timezone issues
                                    const startDay = start.getUTCDate();
                                    const startMonth = start.getUTCMonth();
                                    const startYear = start.getUTCFullYear();
                                    const freq = bill.frequency;
                                    const occurrences = [];

                                    if (freq === 'once') {
                                        if (startMonth === month && startYear === year) {
                                            occurrences.push(startDay);
                                        }
                                        return occurrences;
                                    }

                                    // For recurring: check if this month has an occurrence
                                    // Start date must be on or before this month
                                    const viewDate = new Date(year, month, 1);
                                    const startDate = new Date(startYear, startMonth, startDay);
                                    if (startDate > new Date(year, month + 1, 0)) return occurrences;

                                    if (freq === 'weekly') {
                                        // Find first occurrence of this day-of-week in the month
                                        const startDow = startDate.getDay();
                                        for (let d = 1; d <= daysInMonth; d++) {
                                            const dow = new Date(year, month, d).getDay();
                                            if (dow === startDow) occurrences.push(d);
                                        }
                                    } else if (freq === 'fortnightly') {
                                        // Count fortnights from start date
                                        for (let d = 1; d <= daysInMonth; d++) {
                                            const candidate = new Date(year, month, d);
                                            if (candidate < startDate) continue;
                                            const diffDays = Math.round((candidate - startDate) / (1000 * 60 * 60 * 24));
                                            if (diffDays % 14 === 0) occurrences.push(d);
                                        }
                                    } else if (freq === 'monthly') {
                                        // Same day each month
                                        if (startDay <= daysInMonth) occurrences.push(startDay);
                                    } else if (freq === 'quarterly') {
                                        // Every 3 months from start month
                                        const monthDiff = (year - startYear) * 12 + (month - startMonth);
                                        if (monthDiff >= 0 && monthDiff % 3 === 0) {
                                            if (startDay <= daysInMonth) occurrences.push(startDay);
                                        }
                                    } else if (freq === 'yearly') {
                                        if (startMonth === month && startDay <= daysInMonth) occurrences.push(startDay);
                                    }
                                    return occurrences;
                                };

