                                                {monthBills.sort((a, b) => a.occurrenceDay - b.occurrenceDay).map((bill, idx) => {
                                                    const occDate = new Date(currentYear, currentMonth, bill.occurrenceDay);
                                                    const todayOnly = new Date(today.getFullYear(), today.getMonth(), today.getDate());
                                                    const isOverdue = occDate < todayOnly;
                                                    const freqLabels = { once: 'One-time', weekly: 'Weekly', fortnightly: 'Fortnightly', monthly: 'Monthly', quarterly: 'Quarterly', yearly: 'Yearly' };
                                                    
                                                    const paid = isBillPaid(bill.id, currentYear, currentMonth, bill.occurrenceDay);
                                                    return (
                                                        <div key={bill.id + '-' + bill.occurrenceDay} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '0.5rem 0', borderBottom: darkMode ? '1px solid #3f3f56' : '1px solid #dee2e6', opacity: paid ? 0.6 : 1 }}>
                                                            <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', flex: 1 }}>
                                                                <span style={{ fontSize: '1rem', textDecoration: paid ? 'line-through' : 'none' }}>{bill.icon}</span>
                                                                <div style={{ fontSize: '0.8rem' }}>
                                                                    <div style={{ display: 'flex', alignItems: 'center', gap: '0.4rem' }}>
                                                                        <span style={{ fontWeight: 600, textDecoration: paid ? 'line-through' : 'none' }}>{bill.name}</span>
                                                                        {paid && <span style={{ fontSize: '0.65rem', background: '#52b788', color: 'white', padding: '0.1rem 0.3rem', borderRadius: '8px' }}>Paid ✓</span>}
                                                                        {!paid && bill.frequency !== 'once' && (
                                                                            <span style={{ fontSize: '0.65rem', background: '#2d6a4f', color: 'white', padding: '0.1rem 0.3rem', borderRadius: '8px' }}>
                                                                                🔄 {freqLabels[bill.frequency] || bill.frequency}
                                                                            </span>
                                                                        )}
                                                                    </div>
                                                                    <div style={{ fontSize: '0.7rem', color: isOverdue && !paid ? '#dc3545' : undefined }}>
                                                                        {bill.occurrenceDay} {monthNames[currentMonth].slice(0, 3)} • {formatCurrency(bill.amount)}
                                                                        {isOverdue && !paid ? ' • Overdue' : ''}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div style={{ display: 'flex', gap: '0.5rem', alignItems: 'center' }}>
                                                                <button
                                                                    onClick={() => toggleBillPaid(bill.id, currentYear, currentMonth, bill.occurrenceDay)}
                                                                    style={{
                                                                        background: paid ? '#52b788' : (darkMode ? '#3a3a4e' : '#e9ecef'),
                                                                        color: paid ? 'white' : (darkMode ? 'white' : '#495057'),
                                                                        border: 'none',
                                                                        borderRadius: '6px',
                                                                        padding: '0.25rem 0.6rem',
                                                                        fontSize: '0.75rem',
                                                                        fontWeight: 600,
                                                                        cursor: 'pointer',
                                                                        whiteSpace: 'nowrap'
                                                                    }}
                                                                >
                                                                    {paid ? '✓ Paid' : 'Mark Paid'}
                                                                </button>
                                                                <button className="btn" onClick={() => editBill(bill)} style={{ background: 'transparent', border: 'none', fontSize: '0.85rem', padding: '0.25rem' }}>
                                                                    ✏️
                                                                </button>
                                                                <button className="btn" onClick={() => deleteBill(bill.id)} style={{ background: 'transparent', border: 'none', padding: '0.25rem' }}>
                                                                    <Trash2 size={14} />
                                                                </button>
                                                            </div>
                                                        </div>
                                                    );
                                                })}
                                            </div>
                                        )}
                                        
                                        {bills.length === 0 && !showBillForm && (
                                            <div style={{ textAlign: 'center', padding: '2rem 1rem', fontSize: '0.85rem' }}>
                                                No bills added yet
                                            </div>
                                        )}
                                    </div>
                                );
                            })()}
                        </div>
                    </div>

                    
                    {/* Spending by Category */}
                    <div className="card" style={{
                        padding: '2rem',
                        marginTop: '2rem'
                    }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1.5rem' }}>
                            <h3 style={{ fontFamily: '"Playfair Display", serif', fontSize: '1.5rem', fontWeight: 600, margin: 0, color: '#1b4332' }}>
                                📊 Spending by Category
                            </h3>
                        </div>
                        
                        {(() => {
                            // Combine all expenses from above
                            const allExpenses = [
                                ...yourExpenses.map(e => ({ ...e, source: 'Your', name: e.category, spendingCategory: e.spendingCategory || 'Other' })),
                                ...partnerExpenses.map(e => ({ ...e, source: 'Partner', name: e.category, spendingCategory: e.spendingCategory || 'Other' })),
                                ...jointExpenses.map(e => ({ ...e, source: 'Joint', name: e.category, spendingCategory: e.spendingCategory || 'Other' }))
                            ];
                            
                            // Group by spendingCategory
                            const categoryTotals = {};
                            allExpenses.forEach(exp => {
                                const cat = exp.spendingCategory;
                                if (!categoryTotals[cat]) {
                                    categoryTotals[cat] = { total: 0, icon: exp.icon, expenses: [] };
                                }
                                categoryTotals[cat].total += exp.amount;
                                categoryTotals[cat].expenses.push(exp);
                            });
                            
                            const sortedCategories = Object.entries(categoryTotals)
                                .sort((a, b) => b[1].total - a[1].total);
                            
                            const totalExpenses = sortedCategories.reduce((sum, [_, data]) => sum + data.total, 0);
                            
                            // Get color for category (with fallback)
                            const getColorForCategory = (categoryName) => {
                                return categoryColors[categoryName] || '#95d5b2'; // Default to a nice teal if not set
                            };
                            
                            if (sortedCategories.length === 0) {
                                return <div style={{ textAlign: 'center', padding: '2rem' }}>No expenses to display</div>;
                            }
                            
                            return (
                                <div style={{ display: 'grid', gridTemplateColumns: '300px 1fr', gap: '3rem', alignItems: 'start' }}>
                                    {/* Pie Chart */}
                                    <div style={{ position: 'relative', width: '300px', height: '300px' }}>
                                        <svg viewBox="0 0 200 200" style={{ width: '100%', height: '100%', transform: 'rotate(-90deg)' }}>
                                            {(() => {
                                                let currentAngle = 0;
                                                return sortedCategories.map(([category, data], index) => {
                                                    const percentage = (data.total / totalExpenses) * 100;
                                                    const angle = (percentage / 100) * 360;
                                                    
                                                    const startAngle = currentAngle * Math.PI / 180;
                                                    const endAngle = (currentAngle + angle) * Math.PI / 180;
                                                    
                                                    const x1 = 100 + 90 * Math.cos(startAngle);
                                                    const y1 = 100 + 90 * Math.sin(startAngle);
                                                    const x2 = 100 + 90 * Math.cos(endAngle);
                                                    const y2 = 100 + 90 * Math.sin(endAngle);
                                                    
                                                    const largeArc = angle > 180 ? 1 : 0;
                                                    const path = `M 100 100 L ${x1} ${y1} A 90 90 0 ${largeArc} 1 ${x2} ${y2} Z`;
                                                    
                                                    currentAngle += angle;
                                                    
                                                    return (
                                                        <path
                                                            key={category}
                                                            d={path}
                                                            fill={getColorForCategory(category)}
                                                            stroke="white"
                                                            strokeWidth="2"
                                                        />
                                                    );
                                                });
                                            })()}
                                            <circle cx="100" cy="100" r="50" fill={darkMode ? '#1e1e2e' : 'white'} />
                                        </svg>
                                        <div style={{
                                            position: 'absolute',
                                            top: '50%',
                                            left: '50%',
                                            transform: 'translate(-50%, -50%)',
                                            textAlign: 'center'
                                        }}>
                                            <div style={{ fontSize: '0.7rem', marginBottom: '0.25rem' }}>Total</div>
                                            <div style={{ fontSize: '1.25rem', fontWeight: 700 }}>
                                                {formatCurrency(convertToTimeframe(totalExpenses))}
                                            </div>
                                            <div style={{ fontSize: '0.65rem' }}>/{getTimeframeLabel()}</div>
                                        </div>
                                    </div>
                                    
                                    {/* Legend with Click-to-Expand */}
                                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: '1rem' }}>
                                        {sortedCategories.map(([category, data], index) => {
                                            const percentage = ((data.total / totalExpenses) * 100).toFixed(1);
                                            const isExpanded = expandedCategory === category;
                                            const categoryColor = getColorForCategory(category);
                                            
                                            return (
                                                <div key={category}>
                                                    <div 
                                                        style={{ 
                                                            display: 'flex', 
                                                            alignItems: 'center', 
                                                            gap: '0.75rem',
                                                            padding: '0.5rem',
                                                            borderRadius: '8px',
                                                            background: isExpanded ? (darkMode ? '#2a2a3e' : '#f8f9fa') : 'transparent'
                                                        }}
                                                    >
                                                        {/* Color Picker */}
                                                        <input
                                                            type="color"
                                                            value={categoryColor}
                                                            onChange={(e) => setCategoryColors({ ...categoryColors, [category]: e.target.value })}
                                                            style={{
                                                                width: '32px',
                                                                height: '32px',
                                                                border: 'none',
                                                                borderRadius: '4px',
                                                                cursor: 'pointer',
                                                                flexShrink: 0
                                                            }}
                                                            title="Click to change color"
                                                        />
                                                        <div 
                                                            onClick={() => setExpandedCategory(isExpanded ? null : category)}
                                                            style={{ flex: 1, minWidth: 0, cursor: 'pointer' }}
                                                        >
                                                            <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.25rem' }}>
                                                                <span style={{ fontSize: '1rem' }}>{data.icon}</span>
                                                                <div style={{ fontSize: '0.85rem', fontWeight: 600, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                                                    {category}
                                                                </div>
                                                                <span style={{ fontSize: '0.75rem', opacity: 0.7 }}>{isExpanded ? '▼' : '▶'}</span>
                                                            </div>
                                                            <div style={{ fontSize: '0.75rem' }}>
                                                                {formatCurrency(convertToTimeframe(data.total))} ({percentage}%)
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    {/* Expanded Expense Breakdown */}
                                                    {isExpanded && (
                                                        <div style={{ marginTop: '0.5rem', marginLeft: '2rem', paddingLeft: '1rem', borderLeft: `3px solid ${categoryColor}` }}>
                                                            {data.expenses.map((exp, idx) => {
                                                                const isEditing = editingExpenseCategory?.id === exp.id && editingExpenseCategory?.source === exp.source;
                                                                
                                                                return (
                                                                    <div key={idx} style={{ fontSize: '0.75rem', marginBottom: '0.75rem' }}>
                                                                        {!isEditing ? (
                                                                            <div 
                                                                                onClick={() => setEditingExpenseCategory({ id: exp.id, source: exp.source, currentCategory: exp.spendingCategory || 'Other' })}
                                                                                style={{ 
                                                                                    display: 'flex', 
                                                                                    justifyContent: 'space-between', 
                                                                                    opacity: 0.8,
                                                                                    cursor: 'pointer',
                                                                                    padding: '0.25rem',
                                                                                    borderRadius: '4px',
                                                                                    background: darkMode ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.02)'
                                                                                }}
                                                                                title="Click to change category"
                                                                            >
                                                                                <span>{exp.icon} {exp.name} <span style={{ fontSize: '0.7rem', opacity: 0.7 }}>({exp.source})</span></span>
                                                                                <span style={{ fontWeight: 600 }}>{formatCurrency(convertToTimeframe(exp.amount))}</span>
                                                                            </div>
                                                                        ) : (
                                                                            <div style={{ padding: '0.5rem', background: darkMode ? '#3a3a4e' : '#f8f9fa', borderRadius: '6px' }}>
                                                                                <div style={{ fontSize: '0.7rem', marginBottom: '0.5rem', fontWeight: 600 }}>Change category for: {exp.name}</div>
                                                                                <select
                                                                                    value={editingExpenseCategory.currentCategory}
                                                                                    onChange={(e) => {
                                                                                        const newCat = e.target.value;
                                                                                        if (newCat === '__new__') {
                                                                                            const customCat = prompt('Enter new category name:');
                                                                                            if (customCat) {
                                                                                                addCustomCategory(customCat);
                                                                                                updateExpenseCategory(exp.id, exp.source, customCat);
                                                                                            }
                                                                                        } else {
                                                                                            updateExpenseCategory(exp.id, exp.source, newCat);
                                                                                        }
                                                                                    }}
                                                                                    style={{ width: '100%', padding: '0.4rem', borderRadius: '4px', border: '1px solid #dee2e6', fontSize: '0.75rem', marginBottom: '0.5rem' }}
                                                                                >
                                                                                    <option value="">-- Select Category --</option>
                                                                                    <option value="Housing">🏠 Housing</option>
                                                                                    <option value="Food">🍕 Food</option>
                                                                                    <option value="Transport">🚗 Transport</option>
                                                                                    <option value="Utilities">💡 Utilities</option>
                                                                                    <option value="Entertainment">🎮 Entertainment</option>
                                                                                    <option value="Subscriptions">📱 Subscriptions</option>
                                                                                    <option value="Healthcare">🏥 Healthcare</option>
                                                                                    <option value="Education">🎓 Education</option>
                                                                                    <option value="Shopping">🛍️ Shopping</option>
                                                                                    <option value="Personal">💆 Personal</option>
                                                                                    <option value="Other">💰 Other</option>
                                                                                    {customCategories.map(cat => (
                                                                                        <option key={cat} value={cat}>📂 {cat}</option>
                                                                                    ))}
                                                                                    <option value="__new__">➕ Add New Category...</option>
                                                                                </select>
                                                                                <button 
                                                                                    onClick={() => setEditingExpenseCategory(null)}
                                                                                    style={{ 
                                                                                        padding: '0.3rem 0.6rem', 
                                                                                        background: darkMode ? '#2a2a3e' : '#e9ecef', 
                                                                                        border: 'none', 
                                                                                        borderRadius: '4px', 
                                                                                        fontSize: '0.7rem',
                                                                                        cursor: 'pointer'
                                                                                    }}
                                                                                >
                                                                                    Cancel
                                                                                </button>
                                                                            </div>
                                                                        )}
                                                                    </div>
                                                                );
                                                            })}
                                                        </div>
                                                    )}
                                                </div>
                                            );
                                        })}
                                    </div>
                                </div>
                            );
                        })()}
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<DetailedJointBudget />);
    </script>
    
    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('service-worker.js')
                    .then(reg => console.log('Service Worker registered:', reg))
                    .catch(err => console.log('Service Worker registration failed:', err));
            });
        }
    </script>
</body>
</html>
